{
  "description": "Ask the user before any command that clones or installs code from GitHub.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/confirm_install.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
